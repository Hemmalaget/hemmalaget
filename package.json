{
  "name": "hemmalaget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "run-p lint:*",
    "lint:frontend": "pnpm --dir frontend lint",
    "lint:functions": "pnpm --dir functions lint",
    "dev:frontend": "pnpm --dir frontend build",
    "dev:functions": "pnpm --dir functions dev",
    "dev": "run-p dev:* emulators:start",
    "emulators:start": "firebase emulators:start",
    "emulators:stop": "pkill -f 'firebase/emulators'"
  },
  "dependencies": {
    "firebase-tools": "^15.34.1",
    "npm-run-all": "^4.1.5"
  },
  "packageManager": "pnpm@12.9.0"
}
