*.log
node_modules
.DS_Store
.direnv

# There are no secrets in this repo: the SMTP password lives in Firebase Secret
# Manager. The env files below are Firebase's own, hold config only and are
# committed on purpose. Anything else named .env or .env.* stays ignored.
.env
.env.*
*.secret.local
!/functions/.env
!/extensions/firestore-send-email.env
