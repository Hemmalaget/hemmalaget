{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "pnpm build:watch",
    "serve": "pnpm build && cd .. && npx firebase emulators:start --only functions",
    "shell": "pnpm build && npx firebase functions:shell",
    "start": "pnpm shell",
    "logs": "npx firebase functions:log",
    "format": "prettier -w ."
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  },
  "private": true,
  "packageManager": "pnpm@12.9.0"
}
